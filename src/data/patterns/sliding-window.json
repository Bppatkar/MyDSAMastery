  "order": 1,
  "description": "Track a moving subarray or substring using a window that expands and shrinks to find optimal segments.",
  "coreIdea": "Replace O(n²) nested loops with a single O(n) pass using two boundaries (left, right) that define a window.",
  "whenToUse": [
    "Finding max/min subarray or substring of fixed size k",
    "Longest substring with some constraint (no repeats, at most k distinct)",
    "Minimum window containing all required characters",
    "Counting subarrays with sum equal to target"
  ],
  "triggers": [
    "subarray of size k",
    "longest substring with",
    "minimum window",
    "contiguous subarray",
    "sliding",
    "maximum sum subarray"
  ],
  "timeComplexity": "O(n)",
  "spaceComplexity": "O(1) to O(k)",
  "template": {
  "javascript": "function slidingWindow(arr, k) {\n  let left = 0;\n  let windowSum = 0;\n  let result = -Infinity;\n\n  for (let right = 0; right < arr.length; right++) {\n    windowSum += arr[right]; // expand window\n\n    while (windowSum > k) { // shrink when violated\n      windowSum -= arr[left];\n      left++;\n    }\n\n    result = Math.max(result, right - left + 1);\n  }\n  return result;\n}",
  "python": "def sliding_window(arr, k):\n    left = 0\n    window_sum = 0\n    result = float('-inf')\n    for right in range(len(arr)):\n        window_sum += arr[right]\n        while window_sum > k:\n            window_sum -= arr[left]\n            left += 1\n        result = max(result, right - left + 1)\n    return result"
},
