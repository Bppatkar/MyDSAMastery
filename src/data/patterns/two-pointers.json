    "merge sorted arrays",
    "two sum sorted"
  ],
  "timeComplexity": "O(n)",
  "spaceComplexity": "O(1)",
 "template": {
  "javascript": "function twoPointers(arr, target) {\n  let left = 0;\n  let right = arr.length - 1;\n\n  while (left < right) {\n    const sum = arr[left] + arr[right];\n\n    if (sum === target) {\n      return [left, right]; // found!\n    } else if (sum < target) {\n      left++;  // need bigger sum\n    } else {\n      right--; // need smaller sum\n    }\n  }\n  return [];\n}",
  "python": "def two_pointers(arr, target):\n    left, right = 0, len(arr) - 1\n    while left < right:\n        current = arr[left] + arr[right]\n        if current == target: return [left, right]\n        elif current < target: left += 1\n        else: right -= 1\n    return []"
},
